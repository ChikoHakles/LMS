# Salin ke konfigurasi VirtualHost Apache XAMPP, sesuaikan ServerName dan path checkout.
# Aktifkan mod_rewrite di httpd.conf dan gunakan AllowOverride All agar public/.htaccess berjalan.
<VirtualHost *:80>
    ServerName ruang.test
    DocumentRoot "C:/path/to/ruang-1.0/app/public"

    <Directory "C:/path/to/ruang-1.0/app/public">
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
