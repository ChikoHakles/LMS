# Contoh: letakkan di konfigurasi VirtualHost Apache XAMPP setelah menyesuaikan path.
# Tambahkan 127.0.0.1 ruang.test ke hosts bila memakai nama host ini.
<VirtualHost *:80>
    ServerName ruang.test
    DocumentRoot "C:/Users/hakle/Claude/Projects/Learning Management System/ruang-1.0/app/public"

    <Directory "C:/Users/hakle/Claude/Projects/Learning Management System/ruang-1.0/app/public">
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
